using System;

interface IA
{
    void MethodA();
}

interface IB : IA
{
    void MethodB();
}

class MyClass : IB
{
    public void MethodA()
    {
        Console.WriteLine("Метод A викликано");
    }

    public void MethodB()
    {
        Console.WriteLine("Метод B викликано");
    }
}

class Program
{
    static void Main()
    {
        MyClass obj = new MyClass();
        obj.MethodA();
        obj.MethodB();
    }
}
